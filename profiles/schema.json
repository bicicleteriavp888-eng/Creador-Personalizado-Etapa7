{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CreadorKioskProfile",
  "type": "object",
  "properties": {
    "version": { "type": "string" },
    "profile_name": { "type": "string" },
    "description": { "type": "string" },
    "config": {
      "type": "object",
      "properties": {
        "iso_name": { "type": "string" },
        "version": { "type": "string" },
        "developer": { "type": "string" },
        "release": { "type": "string" },
        "boot_mode": { "type": "string" },
        "app_mode": { "type": "string" },
        "app_url": { "type": "string" },
        "extra_packages": { "type": "string" },
        "extra_groups": { "type": "string" },
        "multi_app": { "type": "boolean" },
        "enable_ssh": { "type": "boolean" },
        "enable_firewall": { "type": "boolean" }
      },
      "required": ["iso_name", "app_mode"]
    }
  },
  "required": ["version", "profile_name", "config"]
}
