#!/usr/bin/env bash
set -euo pipefail
APP_DIR="${CREADOR_PERSONALIZADO_HOME:-${CREADOR_KIOSK_HOME:-/opt/creador-personalizado}}"
if [[ ! -f "$APP_DIR/main.py" ]]; then
  echo "No encuentro Creador Personalizado en $APP_DIR. Ejecutá packaging/install-fedora.sh." >&2
  exit 1
fi
exec /usr/bin/python3 "$APP_DIR/main.py" "$@"
